[Unit]
Description=Pixel Art Editor - HTTP Server
After=network.target

[Service]
Type=simple
ExecStart=python3 -m http.server 8095 --bind 127.0.0.1
WorkingDirectory=/home/martin/projects/pixelart
Restart=always
RestartSec=5
User=martin
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
